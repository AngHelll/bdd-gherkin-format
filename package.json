{
  "name": "bdd-gherkin-format",
  "displayName": "BDD Gherkin Format",
  "description": "Mute presentation for .feature files — Format Document + syntax highlighting. No binding index. Companion to BDD Guardian.",
  "version": "0.9.0",
  "publisher": "anghelll",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a2332",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Formatters",
    "Programming Languages"
  ],
  "keywords": [
    "gherkin",
    "feature",
    "bdd",
    "cucumber",
    "format",
    "formatter",
    "syntax",
    "highlighting",
    "reqnroll",
    "specflow"
  ],
  "activationEvents": [
    "onLanguage:gherkin",
    "onLanguage:feature"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gherkin",
        "aliases": [
          "Gherkin",
          "Feature"
        ],
        "extensions": [
          ".feature"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gherkin",
        "scopeName": "text.gherkin.feature",
        "path": "./syntaxes/gherkin.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[gherkin]": {
        "editor.defaultFormatter": "anghelll.bdd-gherkin-format",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.stickyScroll.enabled": true,
        "editor.formatOnType": true
      }
    },
    "snippets": [
      {
        "language": "gherkin",
        "path": "./snippets/gherkin.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "bddGherkinFormat.insertTableRow",
        "title": "Insert Table Row",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.nextCell",
        "title": "Next Table Cell",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.previousCell",
        "title": "Previous Table Cell",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.alignTable",
        "title": "Align Table",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.insertColumnLeft",
        "title": "Insert Column Left",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.insertColumnRight",
        "title": "Insert Column Right",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.deleteColumn",
        "title": "Delete Column",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.moveColumnLeft",
        "title": "Move Column Left",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.moveColumnRight",
        "title": "Move Column Right",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.sortAscending",
        "title": "Sort Rows by Column (Ascending)",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.sortDescending",
        "title": "Sort Rows by Column (Descending)",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.pasteAsTable",
        "title": "Paste as Table (Excel, CSV, TSV)",
        "category": "Gherkin"
      },
      {
        "command": "bddGherkinFormat.copyTableAsTsv",
        "title": "Copy Table for Excel (TSV)",
        "category": "Gherkin"
      }
    ],
    "submenus": [
      {
        "id": "bddGherkinFormat.table",
        "label": "Gherkin Table"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "bddGherkinFormat.table",
          "group": "1_modification@9",
          "when": "editorLangId == gherkin || editorLangId == feature"
        }
      ],
      "bddGherkinFormat.table": [
        {
          "command": "bddGherkinFormat.pasteAsTable",
          "group": "1_clipboard@1"
        },
        {
          "command": "bddGherkinFormat.copyTableAsTsv",
          "group": "1_clipboard@2",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.alignTable",
          "group": "2_table@1",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.insertColumnLeft",
          "group": "3_column@1",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.insertColumnRight",
          "group": "3_column@2",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.moveColumnLeft",
          "group": "3_column@3",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.moveColumnRight",
          "group": "3_column@4",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.deleteColumn",
          "group": "3_column@5",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.sortAscending",
          "group": "4_sort@1",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.sortDescending",
          "group": "4_sort@2",
          "when": "bddGherkinFormat.inTableRow"
        }
      ],
      "commandPalette": [
        {
          "command": "bddGherkinFormat.insertTableRow",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.nextCell",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.previousCell",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.alignTable",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.insertColumnLeft",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.insertColumnRight",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.deleteColumn",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.moveColumnLeft",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.moveColumnRight",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.sortAscending",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.sortDescending",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.copyTableAsTsv",
          "when": "bddGherkinFormat.inTableRow"
        },
        {
          "command": "bddGherkinFormat.pasteAsTable",
          "when": "editorLangId == gherkin || editorLangId == feature"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bddGherkinFormat.insertTableRow",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && bddGherkinFormat.caretAtTableRowEnd && !suggestWidgetVisible && !inlineSuggestionVisible && !editorHasMultipleSelections"
      },
      {
        "command": "bddGherkinFormat.nextCell",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && bddGherkinFormat.inTableRow && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !editorTabMovesFocus && !editorHasMultipleSelections && config.bddGherkinFormat.tableTabNavigation"
      },
      {
        "command": "bddGherkinFormat.previousCell",
        "key": "shift+tab",
        "when": "editorTextFocus && !editorReadonly && bddGherkinFormat.inTableRow && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !editorTabMovesFocus && !editorHasMultipleSelections && config.bddGherkinFormat.tableTabNavigation"
      }
    ],
    "configuration": {
      "title": "BDD Gherkin Format",
      "properties": {
        "bddGherkinFormat.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Format Document / Format Selection for Gherkin .feature files."
        },
        "bddGherkinFormat.indentSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "maximum": 8,
          "description": "Spaces per indent unit. null uses the editor tab size (Gherkin defaults to 2)."
        },
        "bddGherkinFormat.alignNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Right-align numeric table cells (integers and decimals), like Cucumber Official / Excel."
        },
        "bddGherkinFormat.alignTablesOnType": {
          "type": "boolean",
          "default": true,
          "description": "Realign the table as you type `|`. Needs editor.formatOnType (on by default for Gherkin)."
        },
        "bddGherkinFormat.tableTabNavigation": {
          "type": "boolean",
          "default": true,
          "description": "Tab / Shift+Tab move between table cells and realign the table. Tab on the last cell adds a row."
        },
        "bddGherkinFormat.keywordSpacing": {
          "type": "boolean",
          "default": false,
          "description": "Normalize spacing after step keywords and before a keyword title. Does not change keyword case."
        },
        "bddGherkinFormat.alignStepKeywords": {
          "type": "boolean",
          "default": false,
          "description": "Pad Given/When/Then/And/But/* so step text starts in the same column within each scenario."
        },
        "bddGherkinFormat.tagLayout": {
          "type": "string",
          "enum": [
            "preserve",
            "onePerLine"
          ],
          "default": "preserve",
          "description": "preserve keeps tags as written. onePerLine puts each @tag on its own line."
        },
        "bddGherkinFormat.indentDocStrings": {
          "type": "boolean",
          "default": false,
          "description": "Reindent DocString bodies relative to the fence. Does not reformat the body text."
        },
        "bddGherkinFormat.blankLines": {
          "type": "string",
          "enum": [
            "preserve",
            "pretty"
          ],
          "default": "preserve",
          "description": "preserve keeps blank lines. pretty inserts one blank line before scenarios, rules, and examples, and removes blanks between steps."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node -e \"require('fs').copyFileSync('src/core/dialects.json','out/core/dialects.json')\"",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext .ts",
    "pretest": "npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npx @vscode/vsce package --no-dependencies -o bdd-gherkin-format.vsix",
    "generate:grammar": "node scripts/generate-grammar-keywords.mjs",
    "icon:export": "node scripts/export-marketplace-icon.js",
    "verify:local": "bash scripts/verify-local.sh",
    "publish:check": "bash scripts/publish-check.sh",
    "publish:marketplace": "bash scripts/publish-marketplace.sh"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.24.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AngHelll/bdd-gherkin-format.git"
  }
}
