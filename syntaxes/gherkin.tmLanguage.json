{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gherkin",
  "scopeName": "text.gherkin.feature",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#tag"
    },
    {
      "include": "#docstring_json_triple"
    },
    {
      "include": "#docstring_json_backtick"
    },
    {
      "include": "#docstring_xml_triple"
    },
    {
      "include": "#docstring_xml_backtick"
    },
    {
      "include": "#docstring_sql_triple"
    },
    {
      "include": "#docstring_sql_backtick"
    },
    {
      "include": "#docstring_yaml_triple"
    },
    {
      "include": "#docstring_yaml_backtick"
    },
    {
      "include": "#docstring_yml_triple"
    },
    {
      "include": "#docstring_yml_backtick"
    },
    {
      "include": "#docstring_html_triple"
    },
    {
      "include": "#docstring_html_backtick"
    },
    {
      "include": "#docstring_triple"
    },
    {
      "include": "#docstring_backtick"
    },
    {
      "include": "#table"
    },
    {
      "include": "#feature"
    },
    {
      "include": "#rule"
    },
    {
      "include": "#background"
    },
    {
      "include": "#scenario_outline"
    },
    {
      "include": "#scenario"
    },
    {
      "include": "#examples"
    },
    {
      "include": "#step"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.gherkin",
      "match": "^\\s*#.*$"
    },
    "tag": {
      "match": "^\\s*((?:@[\\w\\.-]+\\s*)+)",
      "captures": {
        "1": {
          "patterns": [
            {
              "match": "@[\\w\\.-]+",
              "name": "entity.name.tag.gherkin"
            }
          ]
        }
      }
    },
    "feature": {
      "match": "^(\\s*)(Necesidad del negocio|Caracteristica|Característica|Funcionalidade|Business Need|Requisito|Ability|Feature)(:)(.*)$",
      "captures": {
        "2": {
          "name": "keyword.control.feature.gherkin"
        },
        "3": {
          "name": "punctuation.separator.dictionary.key-value.gherkin"
        },
        "4": {
          "name": "entity.name.type.feature.gherkin"
        }
      }
    },
    "rule": {
      "match": "^(\\s*)(Regla de negocio|Regla|Regra|Rule)(:)(.*)$",
      "captures": {
        "2": {
          "name": "keyword.control.rule.gherkin"
        },
        "3": {
          "name": "punctuation.separator.dictionary.key-value.gherkin"
        },
        "4": {
          "name": "entity.name.type.rule.gherkin"
        }
      }
    },
    "background": {
      "match": "^(\\s*)(Cenario de Fundo|Cenário de Fundo|Antecedentes|Background|Contexto|Fundo)(:)(.*)$",
      "captures": {
        "2": {
          "name": "keyword.control.background.gherkin"
        },
        "3": {
          "name": "punctuation.separator.dictionary.key-value.gherkin"
        },
        "4": {
          "name": "entity.name.section.background.gherkin"
        }
      }
    },
    "scenario_outline": {
      "match": "^(\\s*)(Delineacao do Cenario|Delineação do Cenário|Esquema del escenario|Esquema do Cenario|Esquema do Cenário|Scenario Template|Scenario Outline)(:)(.*)$",
      "captures": {
        "2": {
          "name": "keyword.control.scenario.gherkin"
        },
        "3": {
          "name": "punctuation.separator.dictionary.key-value.gherkin"
        },
        "4": {
          "name": "entity.name.function.scenario.gherkin"
        }
      }
    },
    "scenario": {
      "match": "^(\\s*)(Escenario|Scenario|Cenario|Cenário|Ejemplo|Example|Exemplo)(:)(.*)$",
      "captures": {
        "2": {
          "name": "keyword.control.scenario.gherkin"
        },
        "3": {
          "name": "punctuation.separator.dictionary.key-value.gherkin"
        },
        "4": {
          "name": "entity.name.function.scenario.gherkin"
        }
      }
    },
    "examples": {
      "match": "^(\\s*)(Scenarios|Cenarios|Cenários|Ejemplos|Examples|Exemplos)(:)(.*)$",
      "captures": {
        "2": {
          "name": "keyword.control.examples.gherkin"
        },
        "3": {
          "name": "punctuation.separator.dictionary.key-value.gherkin"
        },
        "4": {
          "name": "entity.name.section.examples.gherkin"
        }
      }
    },
    "step": {
      "match": "^(\\s*)(Entonces|Cuando|Quando|Dadas|Dados|Entao|Então|Given|Dada|Dado|Pero|Then|When|And|But|Mas|E|Y|\\*)(\\s+)(.*)$",
      "captures": {
        "2": {
          "name": "keyword.other.step.gherkin"
        },
        "4": {
          "name": "meta.step.description.gherkin",
          "patterns": [
            {
              "include": "#string_double"
            },
            {
              "include": "#string_single"
            },
            {
              "include": "#placeholder"
            },
            {
              "include": "#number"
            }
          ]
        }
      }
    },
    "string_double": {
      "name": "string.quoted.double.gherkin",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.gherkin",
          "match": "\\\\."
        }
      ]
    },
    "string_single": {
      "name": "string.quoted.single.gherkin",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.gherkin",
          "match": "\\\\."
        }
      ]
    },
    "placeholder": {
      "name": "variable.parameter.gherkin",
      "match": "<[^>]+>"
    },
    "number": {
      "name": "constant.numeric.gherkin",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "table": {
      "name": "meta.table.gherkin",
      "begin": "^\\s*\\|",
      "end": "$",
      "patterns": [
        {
          "name": "constant.character.escape.gherkin",
          "match": "\\\\\\|"
        },
        {
          "include": "#placeholder"
        },
        {
          "include": "#number"
        },
        {
          "name": "punctuation.separator.table.gherkin",
          "match": "\\|"
        },
        {
          "name": "string.unquoted.table.gherkin",
          "match": "[^|\\d<\\\\]+"
        },
        {
          "name": "string.unquoted.table.gherkin",
          "match": "."
        }
      ]
    },
    "docstring_json_triple": {
      "name": "meta.embedded.block.json.gherkin",
      "begin": "^(\\s*)(\"\"\")[ \\t]*((?i:json))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(\"\"\")",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    },
    "docstring_json_backtick": {
      "name": "meta.embedded.block.json.gherkin",
      "begin": "^(\\s*)(```)[ \\t]*((?i:json))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(```)",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    },
    "docstring_xml_triple": {
      "name": "meta.embedded.block.xml.gherkin",
      "begin": "^(\\s*)(\"\"\")[ \\t]*((?i:xml))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(\"\"\")",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "text.xml"
        }
      ]
    },
    "docstring_xml_backtick": {
      "name": "meta.embedded.block.xml.gherkin",
      "begin": "^(\\s*)(```)[ \\t]*((?i:xml))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(```)",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "text.xml"
        }
      ]
    },
    "docstring_sql_triple": {
      "name": "meta.embedded.block.sql.gherkin",
      "begin": "^(\\s*)(\"\"\")[ \\t]*((?i:sql))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(\"\"\")",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    },
    "docstring_sql_backtick": {
      "name": "meta.embedded.block.sql.gherkin",
      "begin": "^(\\s*)(```)[ \\t]*((?i:sql))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(```)",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    },
    "docstring_yaml_triple": {
      "name": "meta.embedded.block.yaml.gherkin",
      "begin": "^(\\s*)(\"\"\")[ \\t]*((?i:yaml))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(\"\"\")",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "source.yaml"
        }
      ]
    },
    "docstring_yaml_backtick": {
      "name": "meta.embedded.block.yaml.gherkin",
      "begin": "^(\\s*)(```)[ \\t]*((?i:yaml))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(```)",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "source.yaml"
        }
      ]
    },
    "docstring_yml_triple": {
      "name": "meta.embedded.block.yaml.gherkin",
      "begin": "^(\\s*)(\"\"\")[ \\t]*((?i:yml))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(\"\"\")",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "source.yaml"
        }
      ]
    },
    "docstring_yml_backtick": {
      "name": "meta.embedded.block.yaml.gherkin",
      "begin": "^(\\s*)(```)[ \\t]*((?i:yml))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(```)",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "source.yaml"
        }
      ]
    },
    "docstring_html_triple": {
      "name": "meta.embedded.block.html.gherkin",
      "begin": "^(\\s*)(\"\"\")[ \\t]*((?i:html))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(\"\"\")",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "docstring_html_backtick": {
      "name": "meta.embedded.block.html.gherkin",
      "begin": "^(\\s*)(```)[ \\t]*((?i:html))[ \\t]*$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "keyword.other.content-type.gherkin"
        }
      },
      "end": "^(\\s*)(```)",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "docstring_triple": {
      "name": "string.quoted.triple.gherkin",
      "begin": "^(\\s*)(\"\"\")(.*)$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "comment.line.gherkin"
        }
      },
      "end": "^(\\s*)(\"\"\")",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "contentName": "meta.embedded.docstring.gherkin"
    },
    "docstring_backtick": {
      "name": "string.quoted.other.gherkin",
      "begin": "^(\\s*)(```)(.*)$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.string.begin.gherkin"
        },
        "3": {
          "name": "comment.line.gherkin"
        }
      },
      "end": "^(\\s*)(```)",
      "endCaptures": {
        "2": {
          "name": "punctuation.definition.string.end.gherkin"
        }
      },
      "contentName": "meta.embedded.docstring.gherkin"
    }
  }
}
